# Copy to .env and start either command with --dev to load it.
# Process environment values take precedence over .env.
TANA_HOST=127.0.0.1
TANA_PORT=8080
TANA_GRACE_PERIOD=5s
TANA_LOG_LEVEL=INFO
TANA_DATA_DIR=
TANA_WEB_DIR=
# Optional collector base URL: enables automatic Panda enrichment on import.
# Uses TANA_COLLECTOR_API_TOKEN below to authenticate lookups.
TANA_COLLECTOR_URL=

TANA_COLLECTOR_HOST=127.0.0.1
TANA_COLLECTOR_PORT=8081
TANA_COLLECTOR_GRACE_PERIOD=5s
TANA_COLLECTOR_LOG_LEVEL=INFO
# Defaults to the platform data directory under tana-collector.
TANA_COLLECTOR_DATA_DIR=
# Completed original ZIPs and partial transfers; must be writable by the collector.
TANA_COLLECTOR_DOWNLOAD_DIR=/downloads
# Required bearer token for collector API callers; /healthz remains public.
TANA_COLLECTOR_API_TOKEN=

# Complete sitemap index URL; used as configured, with nothing appended.
TANA_COLLECTOR_SITEMAP_URL=https://xml.e-hentai.org/sitemap_index.xml

# Required by the collector; provide the complete Atom feed URL.
PANDA_FEED_URL=
# Measured from the latest persisted capture, including across restarts.
PANDA_FEED_INTERVAL=30m
PANDA_FEED_RETRY_DELAY=1m

# Required by the collector; provide the complete Panda API URL.
PANDA_API_URL=
# One token replenished per interval, up to the burst capacity.
PANDA_RATE_INTERVAL=2500ms
# The collector always uses burst capacity 1.
PANDA_RATE_BURST=4

# Required by the collector; complete favorites URL, including its path.
# No default. The client adds the requested category as the favcat parameter.
# The selected profile must show newest favorites first, 100 entries per page,
# in a table layout exposing the favorite timestamp.
PANDA_FAVORITES_URL=
# Shared by favorites and archive preparation.
# JSON object containing all authentication, settings, and optional cookies.
PANDA_FAVORITES_COOKIES='{"ipb_member_id":"","ipb_pass_hash":"","sp":""}'
# Stable account identity; defaults to the ipb_member_id cookie when unset.
# Supply either this key or a nonempty ipb_member_id cookie.
PANDA_FAVORITES_ACCOUNT_KEY=
# Required by the collector; complete archive preparation URL on the favorites origin, including its path.
PANDA_ARCHIVER_URL=
# Favorites and archive preparation share one request per 10 seconds.
# Metadata keeps separate pacing; all share persisted bans. Feeds remain separate.
