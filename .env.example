# Copy to .env and start either command with --dev to load it.
# Process environment values take precedence over .env.
TANA_HOST=127.0.0.1
TANA_PORT=8080
TANA_GRACE_PERIOD=5s
TANA_LOG_LEVEL=INFO
TANA_DATA_DIR=

TANA_COLLECTOR_HOST=127.0.0.1
TANA_COLLECTOR_PORT=8081
TANA_COLLECTOR_GRACE_PERIOD=5s
TANA_COLLECTOR_LOG_LEVEL=INFO
# Defaults to the platform data directory under tana-collector.
TANA_COLLECTOR_DATA_DIR=

# Required by the collector; provide the complete Atom feed URL.
PANDA_FEED_URL=
# Measured from the latest persisted capture, including across restarts.
PANDA_FEED_INTERVAL=30m
PANDA_FEED_RETRY_DELAY=1m

# Required when constructing a Panda client; provide the complete API URL.
PANDA_API_URL=
# One token replenished per interval, up to the burst capacity.
PANDA_RATE_INTERVAL=2500ms
PANDA_RATE_BURST=4
